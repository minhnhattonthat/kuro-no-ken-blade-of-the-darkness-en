   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "02OLB02A:4ea",
   "ptr": "0x4ea",
   "len": 38,
   "jp": "　ザリガニの化け物のせいで閉鎖されて\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:4c1"
  },
  {
   "id": "02OLB02A:513",
