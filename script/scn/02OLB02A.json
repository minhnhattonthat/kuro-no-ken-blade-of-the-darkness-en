   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "02OLB02A:6cb",
   "ptr": "0x6cb",
   "len": 38,
   "jp": "  が、騎士たち、つまり、貴族の先祖た\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:6a2"
  },
  {
   "id": "02OLB02A:6f4",
   "ptr": "0x6f4",
   "len": 38,
   "jp": "  ちに敗れて隠れ住んだ場所だと聞きま\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:6a2"
  },
  {
   "id": "02OLB02A:71d",
   "ptr": "0x71d",
   "len": 8,
   "jp": "  す。\\f",
   "en": "",
   "max": 8,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:6a2"
  },
  {
   "id": "02OLB02A:729",
   "ptr": "0x729",
   "len": 38,
