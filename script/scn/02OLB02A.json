   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "02OLB02A:694",
   "ptr": "0x694",
   "len": 10,
   "jp": "  ます。\\f",
   "en": "",
   "max": 10,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:66b"
  },
  {
   "id": "02OLB02A:6a2",
   "ptr": "0x6a2",
   "len": 38,
   "jp": "  昔、近隣を治めていたこの地の小領主\\n",
