   "len": 18,
   "jp": "  わかんねーや」\\f",
   "en": "",
   "max": 18,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:40e"
  },
  {
   "id": "02OLB02A:452",
   "ptr": "0x452",
   "len": 34,
   "jp": "「なに？　おれが泥棒の一味だと？\\n",
   "en": "\"What? I'm one of the thieves' gang? How rude! This is my house! You get out!\"",
   "max": 34,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "02OLB02A:477",
   "ptr": "0x477",
   "len": 32,
   "jp": "　失敬な！　ここはおれの家だ！\\n",
   "en": "",
   "max": 32,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:452"
  },
  {
   "id": "02OLB02A:49a",
   "ptr": "0x49a",
   "len": 22,
