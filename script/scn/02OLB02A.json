   "en": "",
   "max": 22,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:452"
  },
  {
   "id": "02OLB02A:4c1",
   "ptr": "0x4c1",
   "len": 38,
   "jp": "「北の門を出ると湿原に行けるんだが、\\n",
   "en": "\"Out the north gate is the way to the Marshland, but it got shut on account of a Giant Crayfish monster.",
