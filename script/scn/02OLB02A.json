   "max": 14,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "02OLB02A:532",
   "ptr": "0x532",
   "len": 30,
   "jp": "　そいつはもう、かたずけた？\\n",
   "en": "",
   "max": 30,
   "lines": 1,
   "speaker": "　・・・え？\\n",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:521"
  },
  {
   "id": "02OLB02A:553",
   "ptr": "0x553",
   "len": 16,
   "jp": "　うぞッ！？」\\f",
   "en": "",
   "max": 16,
   "lines": 1,
   "speaker": "　そいつはもう、かたずけた？\\n",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:521"
  },
  {
   "id": "02OLB02A:569",
   "ptr": "0x569",
   "len": 26,
   "jp": "「あんた、強いんだね～」\\f",
   "en": "\"Wow, you're really strong, huh?\"",
   "max": 26,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "02OLB02A:58c",
   "ptr": "0x58c",
   "len": 24,
   "jp": "「あら？　素敵なお方」\\f",
