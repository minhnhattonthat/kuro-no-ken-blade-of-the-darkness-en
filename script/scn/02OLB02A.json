   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "02OLB02A:5e7",
   "ptr": "0x5e7",
   "len": 24,
   "jp": "  学者じゃないんです。\\n",
   "en": "",
   "max": 24,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:5bc"
  },
  {
   "id": "02OLB02A:603",
   "ptr": "0x603",
   "len": 38,
