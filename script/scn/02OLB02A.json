   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "02OLB02A:752",
   "ptr": "0x752",
   "len": 38,
   "jp": "  んが、噂では、洞窟にはまだ、未発見\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB02A:729"
  },
  {
   "id": "02OLB02A:77b",
   "ptr": "0x77b",
   "len": 18,
