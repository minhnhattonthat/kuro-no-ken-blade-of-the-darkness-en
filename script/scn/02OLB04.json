   "max": 34,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB04:49d"
  },
  {
   "id": "02OLB04:4ec",
   "ptr": "0x4ec",
   "len": 34,
