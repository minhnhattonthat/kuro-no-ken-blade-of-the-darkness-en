   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": "not on a walked path: file scan found this message op"
  },
  {
   "id": "02OLB04:4c6",
   "ptr": "0x4c6",
   "len": 34,
   "jp": "  は、いったい、何なのですか！？\\f",
