   "max": 40,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB04:423"
  },
  {
   "id": "02OLB04:477",
   "ptr": "0x477",
   "len": 34,
   "jp": "  まるで地獄を見てるようでした。\\f",
   "en": "",
   "max": 34,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 02OLB04:423"
  },
  {
   "id": "02OLB04:49d",
   "ptr": "0x49d",
   "len": 38,
   "jp": "　これほどの災いをもたらす《黒竜》と\\n",
