   "status": "box",
   "notes": "box: English in 03YSK69B:9a0"
  },
  {
   "id": "03YSK69B:9d0",
   "ptr": "0x9d0",
   "len": 28,
   "jp": "  どうなるんでしょうね？」\\f",
   "en": "",
   "max": 28,
   "lines": 1,
   "speaker": "　さあ・・・？",
