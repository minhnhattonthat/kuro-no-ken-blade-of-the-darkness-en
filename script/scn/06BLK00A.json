   "lines": 1,
   "speaker": "  はるか南方より来たる、\\n",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK00A:14e"
  },
  {
   "id": "06BLK00A:196",
   "ptr": "0x196",
   "len": 38,
