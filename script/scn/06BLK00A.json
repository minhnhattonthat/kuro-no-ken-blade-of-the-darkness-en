   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK00A:24b",
   "ptr": "0x24b",
   "len": 38,
   "jp": "  我が国において、主要生産物を鉱山に\\n",
