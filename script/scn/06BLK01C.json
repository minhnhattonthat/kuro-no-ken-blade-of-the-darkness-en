   "jp": "　城へ入ったら地下室にいる学者たちに\\n",
   "en": "Once inside the castle, go and see the scholars in the basement. The black-haired girl is there.\"",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK01C:1088",
   "ptr": "0x1088",
   "len": 16,
   "jp": "  会うように。\\n",
   "en": "",
   "max": 16,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK01C:105f"
  },
  {
   "id": "06BLK01C:109b",
   "ptr": "0x109b",
   "len": 32,
