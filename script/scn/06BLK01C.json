   "en": "",
   "max": 32,
   "lines": 1,
   "speaker": "  会うように。\\n",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK01C:105f"
  },
  {
   "id": "06BLK01C:10d7",
   "ptr": "0x10d7",
   "len": 38,
   "jp": "「わたしたちは学者ですから、遺跡にあ\\n",
