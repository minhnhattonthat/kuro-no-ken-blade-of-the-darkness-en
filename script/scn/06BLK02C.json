   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK02C:504",
   "ptr": "0x504",
   "len": 38,
   "jp": "「お前、変わったカッコしてるな・・・\\n",
