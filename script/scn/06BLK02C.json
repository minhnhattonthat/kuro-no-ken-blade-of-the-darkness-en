   "ptr": "0x54c",
   "len": 20,
   "jp": "　ほー、そうかい。\\f",
   "en": "",
   "max": 20,
   "lines": 1,
   "speaker": "　なに？　異国の剣士だと？\\n",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK02C:504"
  },
  {
   "id": "06BLK02C:564",
   "ptr": "0x564",
   "len": 30,
   "jp": "　クライツェンは騎士の国だ。\\n",
