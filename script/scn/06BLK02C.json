   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK02C:52d",
   "ptr": "0x52d",
   "len": 28,
   "jp": "　なに？　異国の剣士だと？\\n",
