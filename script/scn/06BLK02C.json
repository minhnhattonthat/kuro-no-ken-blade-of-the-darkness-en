   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK02C:3c0"
  },
  {
   "id": "06BLK02C:406",
   "ptr": "0x406",
   "len": 38,
   "jp": "「何だ？　仕事をする気になったのか？」",
   "en": "\"What? Ready to take the job now?\"",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK02C:438",
   "ptr": "0x438",
   "len": 38,
   "jp": "「いらっしゃい、じゃんじゃん飲んでっ\\n",
