   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK02C:3c0",
   "ptr": "0x3c0",
   "len": 20,
   "jp": "「・・・そうかい。\\n",
   "en": "\"...That so. Well, if ya change your mind, come on back.\"",
