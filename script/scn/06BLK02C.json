   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK02C:499",
   "ptr": "0x499",
   "len": 32,
   "jp": "「うふふ、何して遊ぶと思った？\\n",
