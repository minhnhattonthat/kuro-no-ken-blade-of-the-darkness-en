   "max": 26,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK02C:499"
  },
  {
   "id": "06BLK02C:4dc",
   "ptr": "0x4dc",
   "len": 22,
