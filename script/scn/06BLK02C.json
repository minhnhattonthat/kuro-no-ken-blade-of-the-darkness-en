   "status": "box",
   "notes": "box: English in 06BLK02C:438"
  },
  {
   "id": "06BLK02C:47a",
   "ptr": "0x47a",
   "len": 18,
   "jp": "「遊びませんか？」",
   "en": "\"Wanna play?\"",
