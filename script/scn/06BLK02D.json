   "jp": "  えた。\\f",
   "en": "",
   "max": 10,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK02D:6d6"
  },
  {
   "id": "06BLK02D:74d",
   "ptr": "0x74d",
   "len": 36,
   "jp": "　呪ってた者を斬ってくれたのだな？\\n",
   "en": "You cut down the one who was cursing me, eh? Well done!",
   "max": 36,
   "lines": 1,
