   "en": "",
   "max": 36,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK02D:682"
  },
  {
   "id": "06BLK02D:6be",
   "ptr": "0x6be",
   "len": 10,
   "jp": "  い！」\\f",
