   "id": "06BLK02D:6d6",
   "ptr": "0x6d6",
   "len": 22,
   "jp": "「見ろ！　直ったぞ！\\n",
   "en": "\"Look! I'm cured! Cured so easily it's almost a letdown! And that nasty cursed feeling is gone too.",
   "max": 22,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK02D:6ef",
   "ptr": "0x6ef",
   "len": 36,
   "jp": "　あっけないほど、あっさり直った！\\n",
   "en": "",
   "max": 36,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK02D:6d6"
  },
  {
   "id": "06BLK02D:716",
   "ptr": "0x716",
   "len": 38,
   "jp": "　しかも、あの呪われてる嫌な感じも消\\n",
