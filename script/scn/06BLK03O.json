   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK03O:de",
   "ptr": "0xde",
   "len": 32,
   "jp": "「家の中で、おとなしくしてろ！\\f",
