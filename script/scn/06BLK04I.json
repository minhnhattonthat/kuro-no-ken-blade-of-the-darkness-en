   "len": 18,
   "jp": "  官のマルダー。\\f",
   "en": "",
   "max": 18,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK04I:524"
  },
