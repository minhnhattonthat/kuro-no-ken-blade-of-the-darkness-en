   "max": 36,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK04I:5c8",
   "ptr": "0x5c8",
   "len": 36,
   "jp": "  ユーバウム公爵がいるってわけさ。\\f",
   "en": "",
   "max": 36,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK04I:5a1"
  },
  {
   "id": "06BLK04I:5f0",
   "ptr": "0x5f0",
   "len": 38,
   "jp": "　もっとも、貴族どうしの対抗心とか縄\\n",
