   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK04I:393",
   "ptr": "0x393",
   "len": 14,
   "jp": "  やろうか？」",
   "en": "the soldiers' chain of command?\"",
   "max": 14,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK04I:3ae",
   "ptr": "0x3ae",
   "len": 36,
   "jp": "「聞いとけば、役立つと思うんだけど\\n",
   "en": "\"I'd say it's worth hearin', y'know.\"",
   "max": 36,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK04I:3d5",
   "ptr": "0x3d5",
   "len": 10,
   "jp": "  なァ」\\f",
   "en": "",
   "max": 10,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK04I:3ae"
  },
  {
   "id": "06BLK04I:3e8",
   "ptr": "0x3e8",
   "len": 38,
   "jp": "「まず、《オールバイン》と、その南の\\n",
