   "len": 40,
   "jp": "  いなんかを逮捕したのは城の兵士・・・\\n",
   "en": "",
   "max": 40,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK04I:750"
  },
  {
   "id": "06BLK04I:7a4",
   "ptr": "0x7a4",
   "len": 28,
