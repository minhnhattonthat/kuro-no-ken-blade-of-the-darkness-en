   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07J:1d8",
   "ptr": "0x1d8",
   "len": 38,
   "jp": "  来られたせいで酒ばっかり飲んでまし\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07J:1af"
  },
  {
   "id": "06BLK07J:201",
   "ptr": "0x201",
   "len": 14,
   "jp": "  たが・・・\\f",
