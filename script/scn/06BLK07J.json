   "max": 40,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07J:2d2"
  },
  {
   "id": "06BLK07J:31f",
   "ptr": "0x31f",
   "len": 10,
