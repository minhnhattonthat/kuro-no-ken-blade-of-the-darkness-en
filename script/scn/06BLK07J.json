   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07J:39f",
   "ptr": "0x39f",
   "len": 38,
   "jp": "「グリンウルド、あんた、ずっと休んで\\n",
