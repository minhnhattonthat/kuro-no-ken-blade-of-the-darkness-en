   "max": 30,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07J:77"
  },
  {
   "id": "06BLK07J:f0",
   "ptr": "0xf0",
   "len": 24,
   "jp": "「私らは行商の者です。\\n",
   "en": "\"We're traveling peddlers. We're waiting here like this for the Master Smith's work to be finished.\"",
   "max": 24,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07J:10b",
   "ptr": "0x10b",
   "len": 38,
   "jp": "  名人の作品が出来上がるのを、こうし\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07J:f0"
  },
  {
   "id": "06BLK07J:134",
   "ptr": "0x134",
   "len": 24,
   "jp": "  て待っておるのです」\\f",
   "en": "",
   "max": 24,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07J:f0"
  },
  {
   "id": "06BLK07J:155",
   "ptr": "0x155",
   "len": 38,
   "jp": "「おれのナマクラも、名人に打ち直して\\n",
