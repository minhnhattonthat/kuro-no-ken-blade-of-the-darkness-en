   "en": "",
   "max": 40,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07J:155"
  },
  {
   "id": "06BLK07J:1af",
   "ptr": "0x1af",
   "len": 38,
   "jp": "「名人も、始めは兵隊に無理やり連れて\\n",
