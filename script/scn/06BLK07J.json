   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07J:23c",
   "ptr": "0x23c",
   "len": 38,
   "jp": "  全滅してからは取りつかれたように仕\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07J:213"
  },
  {
   "id": "06BLK07J:265",
   "ptr": "0x265",
   "len": 38,
   "jp": "  事をこなし始めました。もう、かれこ\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07J:213"
  },
  {
   "id": "06BLK07J:28e",
   "ptr": "0x28e",
   "len": 30,
