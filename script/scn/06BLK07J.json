 "entries": [
  {
   "id": "06BLK07J:35",
   "ptr": "0x35",
   "len": 24,
   "jp": "「いらっしゃいませ～！\\n",
   "en": "\"Welcome! Get the Master Smith's work right here!\"",
   "max": 24,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07J:50",
   "ptr": "0x50",
   "len": 30,
