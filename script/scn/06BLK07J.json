   "max": 30,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07J:35"
  },
  {
   "id": "06BLK07J:77",
   "ptr": "0x77",
   "len": 38,
   "jp": "「噂に違わず、名人の造った剣は凄い！\\n",
   "en": "\"The Master Smith's swords are every bit as amazing as they say! Just hold your hand over one and you feel an icy, unearthly aura!\"",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07J:a0",
   "ptr": "0xa0",
   "len": 38,
   "jp": "　手をかざしただけで、ひんやりとした\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07J:77"
  },
  {
   "id": "06BLK07J:c9",
   "ptr": "0xc9",
   "len": 30,
