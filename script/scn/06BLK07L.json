   "id": "06BLK07L:13c9",
   "ptr": "0x13c9",
   "len": 24,
   "jp": "  なったとしたら・・・\\f",
   "en": "",
   "max": 24,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07L:1356"
  },
  {
   "id": "06BLK07L:13e5",
   "ptr": "0x13e5",
   "len": 34,
   "jp": "  それでも、ぼくらはうまくやって\\n",
