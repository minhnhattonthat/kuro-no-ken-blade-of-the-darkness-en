   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07L:1492",
   "ptr": "0x1492",
   "len": 36,
   "jp": "　終ったあとの話・・・人の心の中の\\n",
   "en": "",
