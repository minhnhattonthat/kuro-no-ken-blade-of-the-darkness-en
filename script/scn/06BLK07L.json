   "len": 22,
   "jp": "　・・・わからねえ」\\f",
   "en": "",
   "max": 22,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07L:1009"
  },
  {
   "id": "06BLK07L:10c0",
   "ptr": "0x10c0",
   "len": 38,
   "jp": "「後ろにいるから、大きな声じゃ言えま\\n",
   "en": "\"He's right behind me, so I can't say it loudly, but... I just can't get used to the frontier folk.",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07L:10e9",
   "ptr": "0x10e9",
   "len": 16,
   "jp": "  せんが・・・\\n",
   "en": "",
   "max": 16,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07L:10c0"
  },
  {
   "id": "06BLK07L:10fc",
   "ptr": "0x10fc",
   "len": 38,
   "jp": "　私はどうも、辺境の人たちには馴染め\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "  せんが・・・\\n",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07L:10c0"
  },
  {
   "id": "06BLK07L:1125",
   "ptr": "0x1125",
   "len": 12,
   "jp": "　ません。\\f",
