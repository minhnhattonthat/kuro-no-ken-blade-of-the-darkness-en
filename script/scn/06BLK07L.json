   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07L:137d",
   "ptr": "0x137d",
   "len": 36,
   "jp": "　ので、こうして、一緒の街にいられ\\n",
   "en": "",
   "max": 36,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07L:1356"
  },
  {
   "id": "06BLK07L:13a4",
   "ptr": "0x13a4",
   "len": 34,
   "jp": "　ますが、もし、《黒竜》がいなく\\n",
