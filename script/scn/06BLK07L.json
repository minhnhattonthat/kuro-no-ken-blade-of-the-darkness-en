   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07L:140a",
   "ptr": "0x140a",
   "len": 20,
   "jp": "　いけるのか・・・\\f",
   "en": "",
