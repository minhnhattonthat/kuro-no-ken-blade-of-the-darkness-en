   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07L:1009"
  },
  {
   "id": "06BLK07L:1057",
   "ptr": "0x1057",
   "len": 26,
   "jp": "　知らない街に来て・・・\\n",
   "en": "",
   "max": 26,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07L:1009"
  },
  {
   "id": "06BLK07L:1074",
