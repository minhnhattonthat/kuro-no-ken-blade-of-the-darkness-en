   "id": "06BLK07O:6d5",
   "ptr": "0x6d5",
   "len": 30,
   "jp": "「ハズレだ！　残念だったな。\\n",
   "en": "\"Wrong! Too bad. As promised, I'm takin' half your money.\"",
   "max": 30,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07O:6f6",
   "ptr": "0x6f6",
   "len": 38,
   "jp": "　約束通り、持ち金の半分いただくぜ」\\f",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07O:6d5"
  },
  {
