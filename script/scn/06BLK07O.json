  {
   "id": "06BLK07O:3e",
   "ptr": "0x3e",
   "len": 38,
   "jp": "「世も末じゃ・・・わしら、このまま、\\n",
   "en": "\"The world's gone to ruin... Are we all just gonna end up as the Black Dragon's dinner, eh?\"",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07O:67",
   "ptr": "0x67",
   "len": 36,
   "jp": "  《黒竜》の餌になってしまうのかの\\n",
   "en": "",
   "max": 36,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07O:3e"
  },
