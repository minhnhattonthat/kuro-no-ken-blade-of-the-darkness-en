   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07O:869"
  },
  {
   "id": "06BLK07O:8a7",
   "ptr": "0x8a7",
   "len": 30,
   "jp": "「この野郎、よくも相棒を！」\\f",
