   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07O:8d6"
  },
  {
   "id": "06BLK07O:951",
   "ptr": "0x951",
   "len": 34,
   "jp": "  よる支配を産み出しかねません。\\f",
   "en": "",
