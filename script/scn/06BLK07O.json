   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07O:9eb"
  },
  {
   "id": "06BLK07O:a3d",
   "ptr": "0xa3d",
