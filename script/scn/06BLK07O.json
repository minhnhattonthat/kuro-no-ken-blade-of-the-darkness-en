   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07O:3e"
  },
  {
   "id": "06BLK07O:a1",
   "ptr": "0xa1",
   "len": 38,
   "jp": "「ここにおられる教祖様の教えは、それ\\n",
   "en": "\"The teachings of our Founder here are ever so, ever so precious.\"",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "06BLK07O:ca",
   "ptr": "0xca",
   "len": 38,
   "jp": "  はそれは、ありがたいものでございま\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 06BLK07O:a1"
  },
  {
   "id": "06BLK07O:f3",
   "ptr": "0xf3",
