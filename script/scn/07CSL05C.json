  {
   "id": "07CSL05C:22",
   "ptr": "0x22",
   "len": 10,
   "jp": "マルダー\\n",
   "en": "Malder",
   "max": 10,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "07CSL05C:2f",
   "ptr": "0x2f",
   "len": 30,
   "jp": "「おや？　これはこれは・・・\\f",
   "en": "\"Oh? Well, well...",
   "max": 30,
   "lines": 1,
   "speaker": "マルダー\\n",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "07CSL05C:51",
   "ptr": "0x51",
   "len": 34,
   "jp": "　あなた方のことは聞きましたよ。\\n",
   "en": "I've heard all about you two. You drove off the monster that possessed us and freed us from the nightmare, I understand...",
   "max": 34,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "07CSL05C:76",
   "ptr": "0x76",
   "len": 38,
   "jp": "　取り付いてた魔物を打ち払い、我らを\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 07CSL05C:51"
  },
  {
   "id": "07CSL05C:9f",
   "ptr": "0x9f",
   "len": 36,
   "jp": "　悪夢から解放してくれたとか・・・\\f",
   "en": "",
   "max": 36,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 07CSL05C:51"
  },
  {
   "id": "07CSL05C:c7",
   "ptr": "0xc7",
   "len": 34,
   "jp": "　実に何とも勇敢な方々ですなァ。\\n",
   "en": "Truly, what valiant souls you are. Why, you've saved us all! You have my deepest gratitude.\"",
   "max": 34,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "07CSL05C:ec",
   "ptr": "0xec",
   "len": 34,
   "jp": "　いや、おかげで、助かりました！\\n",
   "en": "",
   "max": 34,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 07CSL05C:c7"
  },
  {
   "id": "07CSL05C:111",
   "ptr": "0x111",
   "len": 22,
   "jp": "　感謝いたしますぞ」\\f",
   "en": "",
   "max": 22,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 07CSL05C:c7"
  },
  {
