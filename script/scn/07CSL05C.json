   "id": "07CSL05C:6e8",
   "ptr": "0x6e8",
   "len": 12,
   "jp": "　様なの」\\f",
   "en": "",
   "max": 12,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 07CSL05C:6bf"
  },
