   "en": "",
   "max": 8,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 07CSL05C:5eb"
  },
  {
   "id": "07CSL05C:61f",
   "ptr": "0x61f",
   "len": 38,
   "jp": "　申し訳ないが、お話はここまでという\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "　ん。\\n",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 07CSL05C:5eb"
