   "ptr": "0x6bf",
   "len": 38,
   "jp": "「マルダー様って、とっても優しいお父\\n",
   "en": "\"Malder-sama is ever such a kind father.\"",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
