   "ptr": "0x138",
   "len": 38,
   "jp": "「自分が操られていた時に、何をやって\\n",
   "en": "\"Do you remember what you did while you were being controlled?\"",
   "max": 38,
   "lines": 1,
   "speaker": "カイエス\\n",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "07CSL05C:161",
   "ptr": "0x161",
   "len": 28,
   "jp": "　いたか、覚えているか？」\\f",
   "en": "",
   "max": 28,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 07CSL05C:138"
  },
