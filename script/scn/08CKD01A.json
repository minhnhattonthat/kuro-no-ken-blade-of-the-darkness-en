   "max": 38,
   "lines": 1,
   "speaker": "カイエス\\n",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "08CKD01A:53",
   "ptr": "0x53",
   "len": 38,
   "jp": "　の出口を塞いでしまうとはな・・・」\\f",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 08CKD01A:2a"
  },
  {
   "id": "08CKD01A:82",
