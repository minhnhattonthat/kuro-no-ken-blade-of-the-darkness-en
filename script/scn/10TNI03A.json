   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 10TNI03A:4b"
  },
  {
   "id": "10TNI03A:9d",
   "ptr": "0x9d",
   "len": 38,
   "jp": "　し、体力が癒えるのを待たれてはいか\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 10TNI03A:4b"
  },
  {
   "id": "10TNI03A:c6",
   "ptr": "0xc6",
   "len": 16,
