  {
   "id": "10TNI03A:29",
   "ptr": "0x29",
   "len": 30,
   "jp": "「ここは谷間の遺跡です・・・\\f",
   "en": "\"These are the Valley Ruins...",
   "max": 30,
   "lines": 1,
   "speaker": "呪い師\\n",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
