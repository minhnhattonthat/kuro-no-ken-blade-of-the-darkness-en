   "lines": 1,
   "speaker": "カイエス\\n",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "10TNI03A:40f",
   "ptr": "0x40f",
   "len": 38,
   "jp": "　だ。　自分の目で確かめればいいこと\\n",
   "en": "",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 10TNI03A:3e6"
  },
  {
   "id": "10TNI03A:438",
   "ptr": "0x438",
   "len": 14,
   "jp": "　だと・・・\\f",
   "en": "",
   "max": 14,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 10TNI03A:3e6"
  },
  {
   "id": "10TNI03A:44a",
   "ptr": "0x44a",
   "len": 38,
   "jp": "　鏡の幻影が、記憶にあるおれか、ある\\n",
   "en": "Is the mirror's illusion the me I remember, or the me standing here now? This sword will tell me!\"",
   "max": 38,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "10TNI03A:473",
   "ptr": "0x473",
   "len": 34,
   "jp": "　いは、今ここにいるおれなのか。\\n",
   "en": "",
   "max": 34,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 10TNI03A:44a"
  },
  {
   "id": "10TNI03A:498",
   "ptr": "0x498",
   "len": 36,
