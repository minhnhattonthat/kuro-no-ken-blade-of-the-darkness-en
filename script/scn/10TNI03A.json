   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "10TNI03A:3a8",
   "ptr": "0x3a8",
   "len": 32,
   "jp": "　一歩も動いてはいないのです」\\f",
   "en": "",
   "max": 32,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 10TNI03A:37f"
  },
