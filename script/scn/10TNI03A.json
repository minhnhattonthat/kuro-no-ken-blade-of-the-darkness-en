  {
   "id": "10TNI03A:f4",
   "ptr": "0xf4",
   "len": 38,
   "jp": "「そうか、それもいいかもしれん・・・\\n",
   "en": "\"I see. Perhaps that wouldn't be so bad... But tell me, Mystic.",
   "max": 38,
   "lines": 1,
   "speaker": "カイエス\\n",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "10TNI03A:11d",
   "ptr": "0x11d",
   "len": 20,
   "jp": "　だが、呪い師よ。\\f",
   "en": "",
   "max": 20,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 10TNI03A:f4"
  },
  {
   "id": "10TNI03A:135",
   "ptr": "0x135",
   "len": 38,
