   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "10TNI03A:15e",
   "ptr": "0x15e",
   "len": 12,
   "jp": "　のか？」\\f",
   "en": "",
   "max": 12,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 10TNI03A:135"
  },
