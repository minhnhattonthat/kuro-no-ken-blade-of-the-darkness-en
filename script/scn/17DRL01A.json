   "lines": 1,
   "speaker": "村長\\n",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "17DRL01A:3b4",
   "ptr": "0x3b4",
   "len": 26,
   "jp": "　とする者はおらんがね」\\f",
   "en": "",
   "max": 26,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 17DRL01A:38b"
  },
  {
   "id": "17DRL01A:3d7",
   "ptr": "0x3d7",
   "len": 34,
   "jp": "「村長さんは物知りだねェ・・・」\\f",
