   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "17DRL01A:423",
   "ptr": "0x423",
   "len": 40,
   "jp": "　この国の者は誰も足を踏み入れないよ。\\n",
   "en": "",
   "max": 40,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 17DRL01A:402"
  },
  {
   "id": "17DRL01A:44e",
   "ptr": "0x44e",
   "len": 26,
   "jp": "　・・・あいつら以外は」\\f",
   "en": "",
   "max": 26,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "box",
   "notes": "box: English in 17DRL01A:402"
  },
  {
   "id": "17DRL01A:471",
   "ptr": "0x471",
   "len": 38,
