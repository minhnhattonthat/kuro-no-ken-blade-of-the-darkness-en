   "en": "Village Chief",
   "max": 6,
   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "17DRL01A:38b",
   "ptr": "0x38b",
   "len": 38,
   "jp": "「・・・まあ、わざわざ水門を開けよう\\n",
   "en": "\"...Mind you, nobody'd go out of their way to open that floodgate anyhow.\"",
