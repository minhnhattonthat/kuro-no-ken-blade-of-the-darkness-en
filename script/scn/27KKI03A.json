   "lines": 1,
   "speaker": "",
   "kind": "scn",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "27KKI03A:2f4",
   "ptr": "0x2f4",
   "len": 38,
   "jp": "　て、鏡から目が離せなくなってしまっ\\n",
