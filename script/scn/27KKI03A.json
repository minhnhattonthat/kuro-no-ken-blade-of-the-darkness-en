   "kind": "scn",
   "status": "box",
   "notes": "box: English in 27KKI03A:280"
  },
  {
   "id": "27KKI03A:2cb",
   "ptr": "0x2cb",
   "len": 38,
   "jp": "　わたし、その不思議な光景に魅入られ\\n",
